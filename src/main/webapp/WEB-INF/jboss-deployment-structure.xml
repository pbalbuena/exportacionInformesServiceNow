<?xml version="1.0" encoding="UTF-8"?>
<!--
    JBoss EAP trae su propio subsistema de logging (org.jboss.logmanager), que por
    defecto intercepta la configuracion de Logback/SLF4J empaquetada en el WAR.
    Excluyendo el subsistema "logging" y el modulo org.jboss.logging para este
    despliegue, la aplicacion usa su propio Logback (logback-spring.xml) de forma
    aislada, sin choques de classloading con el servidor.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">
    <deployment>
        <exclude-subsystems>
            <subsystem name="logging" />
        </exclude-subsystems>
        <exclusions>
            <module name="org.jboss.logging" />
        </exclusions>
    </deployment>
</jboss-deployment-structure>
